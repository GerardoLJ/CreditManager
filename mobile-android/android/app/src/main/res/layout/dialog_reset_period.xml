<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✂️ Cerrar Periodo Mensual"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Esta acción eliminará los gastos ordinarios del periodo y los apartados marcados como pagados. Tus tarjetas, deudores y planes de MSI NO se verán afectados.\n\nPara confirmar, ingresa tu contraseña maestra:"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_reset_period_password"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_input_field"
        android:hint="Contraseña Maestra"
        android:textColor="#ffffff"
        android:textColorHint="#64748b"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textSize="14sp" />

</LinearLayout>

