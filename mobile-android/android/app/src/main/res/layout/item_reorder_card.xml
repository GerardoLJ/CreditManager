<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_secondary"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tv_reorder_num"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:text="1."
        android:textColor="#94a3b8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/view_reorder_color"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginEnd="10dp" />

    <TextView
        android:id="@+id/tv_reorder_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Nombre Tarjeta"
        android:textColor="#ffffff"
        android:textSize="14sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- TOGGLE / DRAG HANDLE DESLIZABLE -->
    <TextView
        android:id="@+id/tv_reorder_drag_handle"
        android:layout_width="48dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="☰"
        android:textColor="#38bdf8"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mantén presionado y desliza"
        android:paddingHorizontal="8dp" />

</LinearLayout>

