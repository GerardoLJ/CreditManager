<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_dialog_mov_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar Nuevo Gasto"
            android:textColor="#ffffff"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concepto de la compra"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_mov_concept"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="ej. Supermercado, Gasolina"
            android:textColor="#ffffff"
            android:textColorHint="#64748b"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto Total ($)"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_mov_amount"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:hint="0.00"
            android:textColor="#ffffff"
            android:textColorHint="#64748b"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha (YYYY-MM-DD)"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/et_mov_date"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:textColor="#ffffff"
            android:textColorHint="#64748b"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tarjeta de Crédito"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_mov_card"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Persona / Responsable"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_mov_person"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="12dp" />

        <!-- SUBDEUDOR / SUBETIQUETA -->
        <LinearLayout
            android:id="@+id/layout_mov_subperson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️ Subdeudor / Subetiqueta (Opcional)"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_mov_subperson"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>

        <!-- MSI CHECKBOX -->
        <CheckBox
            android:id="@+id/cb_mov_msi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diferir a Meses Sin Intereses (MSI)"
            android:textColor="#cbd5e1"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- MSI MONTHS CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_mov_msi_months"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plazo en Meses"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_mov_msi_months"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

