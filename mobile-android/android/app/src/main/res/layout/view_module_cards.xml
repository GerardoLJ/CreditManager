<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- GLOBAL SUMMARY CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#131e38"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumen Global de Tarjetas"
                    android:textColor="#cbd5e1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- LIMITE TOTAL -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Límite Total"
                            android:textColor="#64748b"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_cards_global_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#ffffff"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- DEUDA TOTAL -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Gastado"
                            android:textColor="#64748b"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_cards_global_spent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#f87171"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- DISPONIBLE TOTAL -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disponible"
                            android:textColor="#64748b"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tv_cards_global_available"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#4ade80"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- UTILIZACION GLOBAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Utilización del Crédito:"
                        android:textColor="#94a3b8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_cards_global_utilization"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0% Saludable"
                        android:textColor="#4ade80"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- HEADER & ADD BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tarjetas Registradas"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reorder_cards"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⇅ Organizar"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_lock"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="8dp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/btn_add_card"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="➕ Nueva Tarjeta"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_primary_button"
                android:paddingHorizontal="12dp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- EMPTY STATE -->
        <TextView
            android:id="@+id/tv_cards_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No tienes tarjetas registradas aún.\nToca '➕ Nueva Tarjeta' para comenzar."
            android:textColor="#64748b"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingVertical="32dp"
            android:visibility="gone" />

        <!-- CARDS LIST CONTAINER -->
        <LinearLayout
            android:id="@+id/layout_cards_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>

