<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_reorder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⇅ Organizar Orden de Tarjetas"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mantén presionado el icono ☰ y desliza tu dedo hacia arriba o abajo para acomodar las tarjetas en el orden que prefieras:"
        android:textColor="#94a3b8"
        android:textSize="13sp"
        android:layout_marginBottom="14dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reorder_cards"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never" />

    <Button
        android:id="@+id/btn_dialog_reorder_done"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="✓ Listo / Guardar Orden"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:background="@drawable/bg_primary_button"
        android:layout_marginTop="16dp" />

</LinearLayout>

