<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#131e38"
    app:cardElevation="2dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABECERA DE LA TARJETA (ELEGANTE, SIN CAJAS NI PARCHES DE COLOR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <!-- INDICADOR DE COLOR DE LA TARJETA -->
            <View
                android:id="@+id/view_card_color_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_green"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_item_card_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tarjeta Oro"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_item_card_cutoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✂️ Corte: Día 15"
                android:textColor="#94a3b8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- MÉTRICAS DE CRÉDITO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Límite"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_limit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$15,000.00"
                    android:textColor="#cbd5e1"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Periodo Actual"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_spent_period"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$3,200.00"
                    android:textColor="#f87171"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensualidad MSI"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_spent_msi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$1,500.00"
                    android:textColor="#fbbf24"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- TOTAL A PAGAR Y DISPONIBLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total a Liquidar"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_total_owed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$4,700.00"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Disponible"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$10,300.00"
                    android:textColor="#4ade80"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- UTILIZACIÓN (TEXTO LIMPIO SIN CAJAS) -->
            <TextView
                android:id="@+id/tv_item_card_utilization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="31% Moderado"
                android:textColor="#facc15"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- APARTADO Y FALTANTE POR APARTAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ya Apartado"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_set_aside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="#4ade80"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Falta por Apartar"
                    android:textColor="#64748b"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_item_card_missing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="#f87171"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CONTENEDOR DE DEUDORES DE ESTA TARJETA -->
        <LinearLayout
            android:id="@+id/layout_item_card_debtors_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 Deudores con saldo pendiente en esta tarjeta:"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/layout_item_card_debtors_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- SEPARADOR INTERNO SUTIL -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1e293b"
            android:layout_marginBottom="10dp" />

        <!-- BOTONES DE ACCIÓN (PLANOS, LIMPIOS, CON ORGANIZACIÓN DE ORDEN) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- BOTÓN MODERNO DE SELECCIONAR Y MOVER DIRECTO -->
            <Button
                android:id="@+id/btn_item_card_move"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⇅ Mover"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_lock"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="6dp"
                app:backgroundTint="@null" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_item_card_msi"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📋 MSI"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_item_card_edit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✏️ Editar"
                android:textColor="#cbd5e1"
                android:textSize="12sp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_item_card_delete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑️"
                android:textColor="#ef4444"
                android:textSize="13sp"
                android:background="?android:attr/selectableItemBackground"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
